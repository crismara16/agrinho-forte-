Use o código com cuidado.🎨 Código CSS (style.css)css/* Configurações Gerais */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

/* Fundo da tela em verde claro */
body {
    background-color: #e8f5e9; 
    color: #333;
    line-height: 1.6;
}

/* Imagem Fixa no Topo */
.imagem-fixa-topo {
    width: 100%;
    height: 250px;
    overflow: hidden;
}

.imagem-fixa-topo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Títulos com cor verde escuro */
h1, h2, h3 {
    color: #1b5e20; 
}

/* Layout */
.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 0;
}

header {
    background-color: #ffffff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
}

.logo h1 span {
    color: #4caf50;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 20px;
}

nav ul li a {
    text-decoration: none;
    color: #1b5e20;
    font-weight: bold;
}

/* Seções */
.hero {
    text-align: center;
    padding: 60px 20px;
    background-color: #c8e6c9;
    margin-bottom: 30px;
}

.sobre-section {
    padding: 40px 0;
    background-color: #ffffff;
    border-radius: 8px;
    margin-bottom: 40px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.sobre-section p {
    margin-bottom: 20px;
    font-size: 1.1rem;
}

/* Botões */
.btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #1b5e20;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    margin-top: 15px;
}

.botoes-reportagem {
    margin: 25px 0;
    display: flex;
    gap: 15px;
}

.btn-reportagem {
    padding: 12px 24px;
    background-color: #2e7d32;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.3s;
}

.btn-reportagem:hover {
    background-color: #1b5e20;
}

/* Grid de Números */
.numeros-grid {
    display: flex;
    gap: 30px;
    margin-top: 30px;
}

.numero-item {
    background-color: #f1f8e9;
    padding: 20px;
    border-left: 5px solid #1b5e20;
    flex: 1;
}
Use o código com cuidado.⚡ Código JavaScript / Script (script.js)javascript// Aguarda a página carregar completamente
document.addEventListener("DOMContentLoaded", function() {
    
    // Seleciona todos os botões de reportagem
    const botoes = document.querySelectorAll('.btn-reportagem');

    // Adiciona a função de clique em cada um deles
    botoes.forEach(botao => {
        botao.addEventListener('click', function() {
            // Pega o link real guardado no atributo 'data-url'
            const urlReal = this.getAttribute('data-url');
            
            // Abre a reportagem real em uma nova aba do navegador
            window.open(urlReal, '_blank');
        });
    });
    
});
